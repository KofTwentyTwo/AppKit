<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates an app's brand assets (vector mark, multi-size .ico) from one
       definition: a rounded gradient tile plus a white stroked glyph given as SVG path
       data in a 512x512 box. WPF renders the bitmaps, so no image tooling is needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KofTwentyTwo.AppKit\KofTwentyTwo.AppKit.csproj" />
  </ItemGroup>

</Project>
