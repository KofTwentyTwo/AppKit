<?xml version="1.0" encoding="utf-8"?>
<Window
   x:Class="AppKit.Sample.WinUI.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

   <Window.SystemBackdrop>
      <MicaBackdrop />
   </Window.SystemBackdrop>

   <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
         <RowDefinition Height="Auto" />
         <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <MenuBar>
         <MenuBarItem Title="File">
            <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
         </MenuBarItem>
         <MenuBarItem Title="View">
            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System theme" GroupName="Theme" Tag="System" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light theme" GroupName="Theme" Tag="Light" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark theme" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
            <MenuFlyoutSeparator />
            <ToggleMenuFlyoutItem x:Name="SplashToggle" Text="Show splash at startup" Click="Splash_Click" />
         </MenuBarItem>
         <MenuBarItem Title="Help">
            <MenuFlyoutItem x:Name="CheckForUpdatesMenuItem" Text="Check for updates" Click="CheckForUpdates_Click" />
            <MenuFlyoutItem x:Name="ActivityLogMenuItem" Text="Activity log" Click="ActivityLog_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="AboutMenuItem" Text="About AppKit Sample" Click="About_Click" />
         </MenuBarItem>
      </MenuBar>

      <StackPanel Grid.Row="1" Spacing="12" Padding="32" MaxWidth="560" HorizontalAlignment="Left">
         <TextBlock x:Name="GreetingText" Style="{ThemeResource TitleTextBlockStyle}" />
         <TextBlock TextWrapping="Wrap" Text="Each control below exercises one AppKit service. Settings persist to %LOCALAPPDATA%\appkit-sample\settings.json; the log lives beside it." />
         <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Write a log entry" Click="LogInfo_Click" />
            <Button Content="Log a handled error" Click="LogError_Click" />
            <Button x:Name="ThrowButton" Content="Throw unhandled" Click="Throw_Click" />
         </StackPanel>
         <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
   </Grid>
</Window>
