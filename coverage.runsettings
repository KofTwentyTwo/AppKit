<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage contract for the 100% gate: every hand-written line in the framework-free
     packages counts. Excluded, with intent:
     - GeneratedCodeAttribute: source-generated regexes, JSON contexts and log methods.
     - ExcludeFromCodeCoverageAttribute: thin pass-throughs to Velopack that need an
       installed app or the network (each carries a justification at its declaration).
     The WinUI and WPF packages are not measured: their views need a live compositor and
     are exercised by the sample apps' UI smoke tests. Their logic lives here instead. -->
<RunSettings>
   <DataCollectionRunSettings>
      <DataCollectors>
         <DataCollector friendlyName="XPlat Code Coverage">
            <Configuration>
               <Format>cobertura</Format>
               <Include>[KofTwentyTwo.AppKit]*,[KofTwentyTwo.AppKit.Updates]*</Include>
               <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
            </Configuration>
         </DataCollector>
      </DataCollectors>
   </DataCollectionRunSettings>
</RunSettings>
